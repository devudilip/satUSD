# satUSD vault app — ONE container for public hosting (Render, Railway, Fly, any VM).
# Bundles a private regtest bitcoind next to the app, so the host only has to
# run a single Docker service. Everything is demo-grade: regtest coins, the
# public "test … junk" mnemonic, and state that resets on every restart.
FROM node:22-slim

ARG BITCOIN_VERSION=28.1
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
 && case "${TARGETARCH:-amd64}" in \
      amd64) BTC_ARCH=x86_64-linux-gnu ;; \
      arm64) BTC_ARCH=aarch64-linux-gnu ;; \
      *) echo "unsupported arch ${TARGETARCH}" && exit 1 ;; \
    esac \
 && cd /tmp \
 && TARBALL="bitcoin-${BITCOIN_VERSION}-${BTC_ARCH}.tar.gz" \
 && curl -fsSLO "https://bitcoincore.org/bin/bitcoin-core-${BITCOIN_VERSION}/${TARBALL}" \
 && curl -fsSLO "https://bitcoincore.org/bin/bitcoin-core-${BITCOIN_VERSION}/SHA256SUMS" \
 && grep " ${TARBALL}\$" SHA256SUMS | sha256sum -c - \
 && tar -xzf "${TARBALL}" \
 && install -m 0755 "bitcoin-${BITCOIN_VERSION}/bin/bitcoind" "bitcoin-${BITCOIN_VERSION}/bin/bitcoin-cli" /usr/local/bin/ \
 && rm -rf /tmp/* \
 && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/tachi-kit/package.json packages/tachi-kit/package.json
COPY packages/engine/package.json packages/engine/package.json
RUN pnpm install --frozen-lockfile

COPY . .

ENV TACHI_NETWORK=regtest \
    BITCOIN_RPC_URL=http://127.0.0.1:18443 \
    BITCOIN_RPC_USER=tachi \
    BITCOIN_RPC_PASSWORD=tachi \
    DEMO_MNEMONIC="test test test test test test test test test test test junk" \
    APP_HOST=0.0.0.0

EXPOSE 4120
CMD ["sh", "scripts/hosted-start.sh"]
