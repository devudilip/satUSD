# signet (default — public chain via Tachi's hosted node, no local bitcoind)
# or regtest (local bitcoind, instant blocks). See docs/SIGNET.md.
TACHI_NETWORK=signet

TACHI_URL_REGTEST=https://rpc-regtest.tachibtc.com
TACHI_URL_SIGNET=https://rpc-signet.tachibtc.com

# Local bitcoind — regtest only (the hosted regtest has no bitcoind attached;
# signet uses Tachi's hosted proxy and ignores these)
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=tachi
BITCOIN_RPC_PASSWORD=tachi

# Demo wallet — regtest/signet only, never mainnet funds
DEMO_MNEMONIC="test test test test test test test test test test test junk"

# Private signet wallet — `pnpm signet:wallet` creates it here and prints the
# address to fund from https://faucet.tachibtc.com. Never reuse the public
# test phrase above on signet: anyone could sweep it.
DEMO_MNEMONIC_SIGNET=

# Optional overrides. Defaults: term 144 blocks on regtest / 3 on signet;
# deposit 300,000 sats on signet.
# DEMO_CSV_BLOCKS=
# DEMO_DEPOSIT_SATS=
